<mujoco model="onrobot_3fg15">

  <asset>
    <mesh name="base" file="./assets/visual/base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_finger" file="./assets/visual/left_finger.stl" scale="0.001 0.001 0.001"/>
    <mesh name="middle_finger" file="./assets/visual/middle_finger.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_finger" file="./assets/visual/right_finger.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_finger_col" file="./assets/collision/left_finger.stl" scale="0.001 0.001 0.001"/>
    <mesh name="middle_finger_col" file="./assets/collision/middle_finger.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_finger_col" file="./assets/collision/right_finger.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <default>
    <default class="3fg15">
      <joint damping="1.0"/>
      <position kp="120" kv="8"/>
    </default>
  </default>

  <worldbody>
    <body name="3fg15_base" pos="0 0 0" quat="0.500000 -0.500000 0.500000 0.500000" childclass="3fg15">
      <!-- Base body (fixed, base_link frame) -->
      <body name="3fg15_base_body" pos="0 0 0">
        <inertial mass="1.3" pos="0 0 0.03" quat="0.707107 -0.707107 0 0"
                  diaginertia="0.015 0.015 0.010"/>
        <geom name="3fg15_base_vis" type="mesh" mesh="base"
              contype="0" conaffinity="0" rgba="0.82 0.82 0.82 1"
              pos="0 0 0" quat="0.707107 -0.707107 0 0"/>
        <geom name="3fg15_base_col" type="mesh" mesh="base"
              pos="0 0 0" quat="0.707107 -0.707107 0 0"/>
      </body>

      <!-- Left finger (revolute, pre-rotated so q=0 is mid-pose) -->
      <body name="left_finger" pos="-0.026 0.015 0" quat="0.748499 0 0 0.663135">
        <inertial mass="0.08" pos="0.026 -0.015 0" quat="0.707107 -0.707107 0 0"
                  diaginertia="0.0001 0.0001 0.0001"/>
        <joint name="left_finger_joint" type="hinge" axis="0 0 1" range="-1.45 1.45"/>
        <geom name="3fg15_left_finger_vis" type="mesh" mesh="left_finger"
              contype="0" conaffinity="0" rgba="0.82 0.82 0.82 1"
              pos="0.026 -0.015 0" quat="0.707107 -0.707107 0 0"/>
        <geom name="3fg15_left_finger_col" type="mesh" mesh="left_finger_col"
              pos="0.026 -0.015 0" quat="0.707107 -0.707107 0 0"/>
      </body>

      <!-- Right finger (revolute, pre-rotated so q=0 is mid-pose) -->
      <body name="right_finger" pos="0.026 0.015 0.15" quat="0.748499 0 0 0.663135">
        <inertial mass="0.08" pos="-0.026 -0.015 -0.15" quat="0.707107 -0.707107 0 0"
                  diaginertia="0.0001 0.0001 0.0001"/>
        <joint name="right_finger_joint" type="hinge" axis="0 0 1" range="-1.45 1.45"/>
        <geom name="3fg15_right_finger_vis" type="mesh" mesh="right_finger"
              contype="0" conaffinity="0" rgba="0.82 0.82 0.82 1"
              pos="-0.026 -0.015 -0.15" quat="0.707107 -0.707107 0 0"/>
        <geom name="3fg15_right_finger_col" type="mesh" mesh="right_finger_col"
              pos="-0.026 -0.015 -0.15" quat="0.707107 -0.707107 0 0"/>
      </body>

      <!-- Center finger (revolute, pre-rotated so q=0 is mid-pose) -->
      <body name="center_finger" pos="0 -0.03 0" quat="0.748499 0 0 0.663135">
        <inertial mass="0.08" pos="0 0.03 0" quat="0.707107 -0.707107 0 0"
                  diaginertia="0.0001 0.0001 0.0001"/>
        <joint name="center_finger_joint" type="hinge" axis="0 0 1" range="-1.45 1.45"/>
        <geom name="3fg15_center_finger_vis" type="mesh" mesh="middle_finger"
              contype="0" conaffinity="0" rgba="0.82 0.82 0.82 1"
              pos="0 0.03 0" quat="0.707107 -0.707107 0 0"/>
        <geom name="3fg15_center_finger_col" type="mesh" mesh="middle_finger_col"
              pos="0 0.03 0" quat="0.707107 -0.707107 0 0"/>
      </body>

      <!-- TCP -->
      <body name="gripper_tcp" pos="0 0 0.135">
        <site name="pinch" pos="0 0 0" type="sphere" group="5" rgba="0.9 0.9 0.9 1" size="0.005"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="left_finger_act" joint="left_finger_joint" class="3fg15" forcerange="-12 12" ctrlrange="-1.45 1.45"/>
    <position name="right_finger_act" joint="right_finger_joint" class="3fg15" forcerange="-12 12" ctrlrange="-1.45 1.45"/>
    <position name="center_finger_act" joint="center_finger_joint" class="3fg15" forcerange="-12 12" ctrlrange="-1.45 1.45"/>
  </actuator>

</mujoco>
