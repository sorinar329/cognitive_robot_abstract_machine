index b3c5f8e..d7ec312 100644
--- a/giskardpy_ros/giskardpy_ros/launch_helpers.py
+++ b/giskardpy_ros/giskardpy_ros/launch_helpers.py
@@ -12,6 +12,8 @@ def giskard_launch_description(
     xacro_file=None,
     rviz=False,
     map_world_tf=False,
+    rviz_config=None,
+    map_root_link=None,
 ):
     """Build a LaunchDescription for a giskard robot.
 
@@ -23,6 +25,10 @@ def giskard_launch_description(
         "robots/hsrb4s.urdf.xacro" (optional).
     :param rviz: include the rviz2 node.
     :param map_world_tf: include a map->world static_transform_publisher.
+    :param rviz_config: path of the rviz config within this package, e.g.
+        "launch/rviz_config/tracy.rviz" (optional; rviz's default config otherwise).
+    :param map_root_link: the robot's root link, connected to map by a
+        static_transform_publisher (optional).
     """
     nodes = []
 
@@ -37,13 +43,38 @@ def giskard_launch_description(
             )
         )
 
+    if map_root_link:
+        nodes.append(
+            Node(
+                package="tf2_ros",
+                executable="static_transform_publisher",
+                name="map_root_link_transform_publisher",
+                output="screen",
+                arguments=[
+                    "--frame-id",
+                    "map",
+                    "--child-frame-id",
+                    map_root_link,
+                ],
+            )
+        )
+
     if rviz:
+        rviz_arguments = []
+        if rviz_config:
+            rviz_arguments = [
+                "-d",
+                PathJoinSubstitution(
+                    [FindPackageShare("giskardpy_ros"), *rviz_config.split("/")]
+                ),
+            ]
         nodes.append(
             Node(
                 package="rviz2",
                 executable="rviz2",
                 name="rviz2",
                 output="screen",
+                arguments=rviz_arguments,
             )
         )
 
