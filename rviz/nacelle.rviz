Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Offset:
        X: 0
        Y: 0
        Z: -0.12
    - Class: rviz_default_plugins/RobotModel
      Name: Nacelle
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF (inspection points)
      Enabled: false
      Show Names: true
      Marker Scale: 0.3
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11
      Focal Point:
        X: -1.5
        Y: 0
        Z: 1.2
      Pitch: 0.45
      Yaw: 4.2
