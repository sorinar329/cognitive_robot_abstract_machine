    rdfs:domain wt:Fault ;
    rdfs:range wt:InspectionPoint .

wt:providesAccessTo a owl:ObjectProperty ;
    rdfs:label "Provides Access To"@en ;
    rdfs:comment "Equipment through which a zone is reached."@en ;
    rdfs:domain wt:PhysicalObject ;
    rdfs:range wt:Zone .

wt:signal_gearbox_oil_level a wt:ConditionSignal,
        owl:NamedIndividual ;
    rdfs:label "Gearbox oil level"@en ;
    wt:nominalValue 1.0 ;
    wt:unit "fraction of nominal"^^xsd:string ;
    rdfs:comment "Condition monitoring signal."@en .

wt:tower_inspect_anchor_nuts a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Tower: anchor nuts"@en ;
    wt:inspects wt:tower_section_1 ;
    wt:locatedInZone wt:zone_outside ;
    wt:viewDistance 1.8 ;
    rdfs:comment "anchor bolt nuts on the base flange"@en .

wt:tower_inspect_base_coating a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Tower: base coating"@en ;
    wt:inspects wt:tower_section_1 ;
    wt:locatedInZone wt:zone_outside ;
    wt:viewDistance 3.0 ;
    rdfs:comment "tower coating near the base: corrosion, paint damage"@en .

wt:tower_inspect_cable_loop a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Tower: cable loop"@en ;
    wt:inspects wt:tower_section_4 ;
    wt:locatedInZone wt:zone_tower ;
    wt:viewDistance 1.45 ;
    rdfs:comment "power cable loop at the saddle on the yaw deck: chafed insulation"@en .

wt:tower_inspect_door a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Tower: door"@en ;
    wt:inspects wt:tower_section_1 ;
    wt:locatedInZone wt:zone_outside ;
    wt:viewDistance 6.0 ;
    rdfs:comment "tower entrance door (closed, undamaged)"@en .

wt:tower_inspect_flange_2 a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Tower: flange 2"@en ;
    wt:inspects wt:tower_section_2 ;
    wt:locatedInZone wt:zone_tower ;
    wt:viewDistance 0.55 ;
    rdfs:comment "flange 2 bolts (M42): torque markings on the nuts under the flange"@en .

wt:tower_inspect_flange_3 a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Tower: flange 3"@en ;
    wt:inspects wt:tower_section_3 ;
    wt:locatedInZone wt:zone_tower ;
    wt:viewDistance 0.55 ;
    rdfs:comment "flange 3 bolts (M36): torque markings on the nuts under the flange"@en .

wt:visitedBy a owl:ObjectProperty ;
    rdfs:label "Visited By"@en .

wt:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "Something that acts: a robot or a person."@en ;
    rdfs:subClassOf wt:PhysicalObject .

wt:Blade a owl:Class ;
    rdfs:label "Blade"@en ;
    rdfs:comment "Rotor blade, lofted from the IEA airfoils."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:Rotor ],
        wt:StructuralComponent .

wt:Erosion a owl:Class ;
    rdfs:label "Erosion"@en ;
    rdfs:comment "Material worn away by impact (rain, dust), e.g. blade leading edges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:StructuralRepair ],
        wt:MaterialDegradation .

wt:FastenerFault a owl:Class ;
    rdfs:label "Fastener Fault"@en ;
    rdfs:comment "A bolted joint lost preload or a fastener is missing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue wt:acp_rp_401 ;
            owl:onProperty wt:describedIn ],
        wt:Fault .

wt:FlangeBoltSet a owl:Class ;
    rdfs:label "Flange Bolt Set"@en ;
    dcterms:source "ACP RP 401 (by analogy for the thresholds)" ;
    rdfs:comment "Bolts of an internal tower flange joint, with torque markings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass wt:TowerSection ;
            owl:onProperty wt:fastens ],
        wt:BoltSet .

wt:Gearbox a owl:Class ;
    rdfs:label "Gearbox"@en ;
    rdfs:comment "Three-stage gearbox, ratio 1:97."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:Drivetrain ],
        wt:DrivetrainComponent .

wt:LightningDamage a owl:Class ;
    rdfs:label "Lightning Damage"@en ;
    rdfs:comment "Damage from a lightning strike."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:StructuralRepair ],
        wt:ExternalDamage .

wt:LooseFastener a owl:Class ;
    rdfs:label "Loose Fastener"@en ;
    rdfs:comment "Nut or bolt turned back (torque marking offset): lost preload."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( wt:Retighten wt:Retension ) ] ],
        wt:FastenerFault .

wt:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A human."@en ;
    rdfs:subClassOf wt:Agent .

wt:RestPlatform a owl:Class ;
    rdfs:label "Rest Platform"@en ;
    rdfs:comment "Platform about 1.1 m below a flange joint, for bolt checks."@en ;
    rdfs:subClassOf wt:Platform .

wt:RestoreConfiguration a owl:Class ;
    rdfs:label "Restore Configuration"@en ;
    rdfs:comment "Close, release or put back what was left in the wrong state."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:RobotHand a owl:Class ;
    rdfs:label "Robot Hand"@en ;
    rdfs:comment "An end effector with fingers."@en ;
    rdfs:subClassOf wt:RobotPart .

wt:RobotPart a owl:Class ;
    rdfs:label "Robot Part"@en ;
    rdfs:comment "A part of a robot."@en ;
    rdfs:subClassOf wt:Artifact .

wt:Rotor a owl:Class ;
    rdfs:label "Rotor"@en ;
    rdfs:comment "Hub with three blades."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:WindTurbine ],
        wt:Assembly .

wt:Tool a owl:Class ;
    rdfs:label "Tool"@en ;
    rdfs:comment "A hand tool or tool set."@en ;
    rdfs:subClassOf wt:Artifact .

wt:action_ParkArmsAction a wt:CRAMAction,
        owl:NamedIndividual ;
    rdfs:label "ParkArmsAction"@en ;
    rdfs:comment "Move the arms to the park pose."@en .

wt:action_RideCarrier a wt:CRAMAction,
        owl:NamedIndividual ;
    rdfs:label "RideCarrier"@en ;
    rdfs:comment "Stand on a lift car or platform while its joint moves."@en .

wt:cabinet_controller a wt:ControllerCabinet,
        owl:NamedIndividual ;
    rdfs:label "Cabinet controller"@en ;
    wt:mountedOn wt:nacelle ;
    wt:partOf wt:nacelle_assembly ;
    wt:urdfLink "cabinet_controller"^^xsd:string .

wt:cabinet_converter a wt:ConverterCabinet,
        owl:NamedIndividual ;
    rdfs:label "Cabinet converter"@en ;
    wt:mountedOn wt:nacelle ;
    wt:partOf wt:nacelle_assembly ;
    wt:urdfLink "cabinet_converter"^^xsd:string .

wt:cooling_unit a wt:CoolingUnit,
        owl:NamedIndividual ;
    rdfs:label "Cooling unit"@en ;
    wt:mountedOn wt:nacelle ;
    wt:partOf wt:nacelle_assembly ;
    wt:urdfLink "cooling_unit"^^xsd:string .

wt:describedIn a owl:ObjectProperty ;
    rdfs:label "Described In"@en ;
    rdfs:comment "Where a procedure or threshold is described."@en ;
    rdfs:range wt:MaintenanceDocument .

wt:hub a wt:Hub,
        owl:NamedIndividual ;
    rdfs:label "Hub"@en ;
    wt:mountedOn wt:main_shaft ;
    wt:partOf wt:rotor ;
    wt:urdfLink "hub"^^xsd:string .

wt:modality_thermal a wt:SensingModality,
        owl:NamedIndividual ;
    rdfs:label "Thermal camera"@en .

wt:observableBy a owl:ObjectProperty ;
    rdfs:label "Observable By"@en ;
    rdfs:comment "How the fault can be observed."@en ;
    rdfs:domain wt:Fault ;
    rdfs:range wt:SensingModality .

wt:service_lift a wt:ServiceLift,
        owl:NamedIndividual ;
    rdfs:label "Service lift"@en ;
    wt:mountedOn wt:tower_section_1 ;
    wt:partOf wt:tower ;
    wt:providesAccessTo wt:zone_tower ;
    wt:speed 4.0 ;
    wt:travel 105.46 ;
    wt:urdfLink "service_lift"^^xsd:string .

wt:signal_power_curve_deficit_percent a wt:ConditionSignal,
        owl:NamedIndividual ;
    rdfs:label "Power curve deficit percent"@en ;
    wt:nominalValue 0.0 ;
    wt:unit "%"^^xsd:string ;
    rdfs:comment "Condition monitoring signal."@en .

wt:AccessStructure a owl:Class ;
    rdfs:label "Access Structure"@en ;
    rdfs:comment "Structure for moving around the turbine."@en ;
    rdfs:subClassOf wt:TurbineComponent .

wt:Drivetrain a owl:Class ;
    rdfs:label "Drivetrain"@en ;
    rdfs:comment "Main shaft, main bearing, gearbox, high-speed shaft, brake, coupling and generator."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:Nacelle ],
        [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:WindTurbine ],
        wt:Assembly .

wt:InspectionRound a owl:Class ;
    rdfs:label "Inspection Round"@en ;
    rdfs:comment "Visit inspection points and report their state."@en ;
    rdfs:subClassOf wt:RobotTask .

wt:Ladder a owl:Class ;
    rdfs:label "Ladder"@en ;
    rdfs:comment "Ladder with fall-arrest rail."@en ;
    rdfs:subClassOf wt:AccessStructure .

wt:Leak a owl:Class ;
    rdfs:label "Leak"@en ;
    rdfs:comment "A fluid escapes where it should not."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue wt:acp_om_recommended_practices ;
            owl:onProperty wt:describedIn ],
        wt:Fault .

wt:StructuralRepair a owl:Class ;
    rdfs:label "Structural Repair"@en ;
    rdfs:comment "Repair concrete, metal or composite structure."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:UnsafeCondition a owl:Class ;
    rdfs:label "Unsafe Condition"@en ;
    rdfs:comment "A configuration that is unsafe or not allowed in operation."@en ;
    rdfs:subClassOf wt:Fault .

wt:fast_shaft a wt:HighSpeedShaft,
        owl:NamedIndividual ;
    rdfs:label "Fast shaft"@en ;
    wt:mountedOn wt:drivetrain ;
    wt:partOf wt:drivetrain ;
    wt:urdfLink "fast_shaft"^^xsd:string .

wt:foundation_system a wt:Foundation,
        owl:NamedIndividual ;
    rdfs:label "Foundation"@en ;
    wt:partOf wt:iea_3_4_130_rwt .

wt:generator a wt:Generator,
        owl:NamedIndividual ;
    rdfs:label "Generator"@en ;
    wt:mountedOn wt:drivetrain ;
    wt:partOf wt:drivetrain ;
    wt:urdfLink "generator"^^xsd:string .

wt:main_shaft_inspect_shrink_disc a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Main shaft: shrink disc"@en ;
    wt:inspects wt:main_shaft ;
    wt:locatedInZone wt:zone_nacelle ;
    wt:viewDistance 1.6 ;
    rdfs:comment "shrink disc bolts (torque markers) and fretting"@en .

wt:rotor a wt:Rotor,
        owl:NamedIndividual ;
    rdfs:label "Rotor"@en ;
    wt:partOf wt:iea_3_4_130_rwt .

wt:rotor_lock a wt:RotorLock,
        owl:NamedIndividual ;
    rdfs:label "Rotor lock"@en ;
    wt:mountedOn wt:main_bearing ;
    wt:partOf wt:drivetrain ;
    wt:urdfLink "rotor_lock"^^xsd:string .

wt:service_crane a wt:ServiceCrane,
        owl:NamedIndividual ;
    rdfs:label "Service crane"@en ;
    wt:partOf wt:nacelle_assembly .

wt:weather_mast a wt:WeatherMast,
        owl:NamedIndividual ;
    rdfs:label "Weather mast"@en ;
    wt:mountedOn wt:nacelle ;
    wt:partOf wt:nacelle_assembly ;
    wt:urdfLink "weather_mast"^^xsd:string .

wt:MaintenanceDocument a owl:Class ;
    rdfs:label "Maintenance Document"@en ;
    rdfs:comment "A manual or recommended practice describing inspections or repairs."@en ;
    rdfs:subClassOf owl:Thing .

wt:ReplacePart a owl:Class ;
    rdfs:label "Replace Part"@en ;
    rdfs:comment "Replace a worn or broken part."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:Robot a owl:Class ;
    rdfs:label "Robot"@en ;
    rdfs:comment "A robot."@en ;
    rdfs:subClassOf wt:Agent,
        wt:Artifact .

wt:TowerSection a owl:Class ;
    rdfs:label "Tower Section"@en ;
    rdfs:comment "One bolted steel tower section."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:Tower ],
        wt:StructuralComponent .

wt:action_StraightMove a wt:CRAMAction,
        owl:NamedIndividual ;
    rdfs:label "StraightMove"@en ;
    rdfs:comment "Straight base move without route planning."@en .

wt:brake_caliper a wt:BrakeCaliper,
        owl:NamedIndividual ;
    rdfs:label "Brake caliper"@en ;
    wt:mountedOn wt:drivetrain ;
    wt:partOf wt:drivetrain ;
    wt:urdfLink "brake_caliper"^^xsd:string .

wt:main_shaft a wt:MainShaft,
        owl:NamedIndividual ;
    rdfs:label "Main shaft"@en ;
    wt:mountedOn wt:drivetrain ;
    wt:partOf wt:drivetrain ;
    wt:urdfLink "main_shaft"^^xsd:string .

wt:Artifact a owl:Class ;
    rdfs:label "Artifact"@en ;
    rdfs:comment "A physical object made for a purpose."@en ;
    rdfs:subClassOf wt:PhysicalObject .

wt:AuxiliarySystem a owl:Class ;
    rdfs:label "Auxiliary System"@en ;
    rdfs:comment "Supporting systems."@en ;
    rdfs:subClassOf wt:TurbineComponent .

wt:SensingModality a owl:Class ;
    rdfs:label "Sensing Modality"@en ;
    rdfs:comment "How a condition can be observed."@en ;
    rdfs:subClassOf owl:Thing .

wt:Severity a owl:Class ;
    rdfs:label "Severity"@en ;
    rdfs:comment "How urgent a fault is."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( wt:severity_low wt:severity_medium wt:severity_high ) ] .

wt:blade_1 a wt:Blade,
        owl:NamedIndividual ;
    rdfs:label "Blade 1"@en ;
    wt:mountedOn wt:hub ;
    wt:partOf wt:rotor ;
    wt:urdfLink "blade_1"^^xsd:string .

wt:blade_2 a wt:Blade,
        owl:NamedIndividual ;
    rdfs:label "Blade 2"@en ;
    wt:mountedOn wt:hub ;
    wt:partOf wt:rotor ;
    wt:urdfLink "blade_2"^^xsd:string .

wt:blade_3 a wt:Blade,
        owl:NamedIndividual ;
    rdfs:label "Blade 3"@en ;
    wt:mountedOn wt:hub ;
    wt:partOf wt:rotor ;
    wt:urdfLink "blade_3"^^xsd:string .

wt:iea_3_4_130_rwt a wt:WindTurbine,
        owl:NamedIndividual ;
    rdfs:label "IEA-3.4-130-RWT"@en ;
    wt:hubHeight 110.0 ;
    wt:ratedPower 3.37 ;
    wt:rotorDiameter 130.0 ;
    wt:towerHeight 108.0 ;
    rdfs:comment "The modelled land-based reference turbine."@en .

wt:main_bearing a wt:MainBearing,
        owl:NamedIndividual ;
    rdfs:label "Main bearing"@en ;
    wt:mountedOn wt:drivetrain ;
    wt:partOf wt:drivetrain ;
    wt:urdfLink "main_bearing"^^xsd:string .

wt:tower_section_4 a wt:TowerSection,
        owl:NamedIndividual ;
    rdfs:label "Tower section 4"@en ;
    wt:mountedOn wt:tower_section_3 ;
    wt:partOf wt:tower ;
    wt:urdfLink "tower_section_4"^^xsd:string .

wt:Assembly a owl:Class ;
    rdfs:label "Assembly"@en ;
    rdfs:comment "A major structural or functional group of a wind turbine."@en ;
    rdfs:subClassOf wt:Artifact .

wt:Crack a owl:Class ;
    rdfs:label "Crack"@en ;
    rdfs:comment "A crack in concrete, metal, composite or elastomer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:StructuralRepair ],
        wt:MaterialDegradation .

wt:ElectricalComponent a owl:Class ;
    rdfs:label "Electrical Component"@en ;
    rdfs:comment "Power conversion, control and grounding."@en ;
    rdfs:subClassOf wt:TurbineComponent .

wt:Zone a owl:Class ;
    rdfs:label "Zone"@en ;
    rdfs:comment "A region of the turbine where a robot works: outside, inside the tower, inside the nacelle."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( wt:zone_outside wt:zone_tower wt:zone_nacelle ) ] .

wt:action_LookAtAction a wt:CRAMAction,
        owl:NamedIndividual ;
    rdfs:label "LookAtAction"@en ;
    rdfs:comment "Point the camera at a target."@en .

wt:g1 a wt:UnitreeG1,
        owl:NamedIndividual ;
    rdfs:label "Unitree G1"@en ;
    wt:cameraHeight 1.27 ;
    wt:hasRobotPart wt:g1_d435,
        wt:g1_left_hand,
        wt:g1_right_hand ;
    wt:mass 34.8 ;
    rdfs:comment "The humanoid of the CRAM stack (OFFIS description)."@en .

wt:severity_low a wt:Severity,
        owl:NamedIndividual ;
    rdfs:label "low"@en ;
    wt:severityRank 1 .

wt:tower_section_2 a wt:TowerSection,
        owl:NamedIndividual ;
    rdfs:label "Tower section 2"@en ;
    wt:mountedOn wt:tower_section_1 ;
    wt:partOf wt:tower ;
    wt:urdfLink "tower_section_2"^^xsd:string .

wt:tower_section_3 a wt:TowerSection,
        owl:NamedIndividual ;
    rdfs:label "Tower section 3"@en ;
    wt:mountedOn wt:tower_section_2 ;
    wt:partOf wt:tower ;
    wt:urdfLink "tower_section_3"^^xsd:string .

wt:CRAMAction a owl:Class ;
    rdfs:label "CRAMAction"@en ;
    rdfs:comment "An action designator of the CRAM stack (coraplex) used in the plans."@en ;
    rdfs:subClassOf owl:Thing .

wt:MaterialDegradation a owl:Class ;
    rdfs:label "Material Degradation"@en ;
    rdfs:comment "The material itself is damaged or worn."@en ;
    rdfs:subClassOf wt:Fault .

wt:StructuralComponent a owl:Class ;
    rdfs:label "Structural Component"@en ;
    rdfs:comment "Load-carrying structure."@en ;
    rdfs:subClassOf wt:TurbineComponent .

wt:FunctionalFault a owl:Class ;
    rdfs:label "Functional Fault"@en ;
    rdfs:comment "Something does not work as it should."@en ;
    rdfs:subClassOf wt:Fault .

wt:PhysicalObject a owl:Class ;
    rdfs:label "Physical Object"@en ;
    rdfs:comment "Anything with a location in space: the turbine and its parts, robots, tools, people."@en ;
    rdfs:subClassOf owl:Thing .

wt:BoltSet a owl:Class ;
    rdfs:label "Bolt Set"@en ;
    rdfs:comment "The bolts of one bolted joint."@en ;
    rdfs:subClassOf wt:Fastener .

wt:HandlingEquipment a owl:Class ;
    rdfs:label "Handling Equipment"@en ;
    rdfs:comment "Equipment that lifts or carries loads and people."@en ;
    rdfs:subClassOf wt:TurbineComponent .

wt:foundation a wt:FoundationPlinth,
        owl:NamedIndividual ;
    rdfs:label "Foundation"@en ;
    wt:partOf wt:foundation_system ;
    wt:urdfLink "foundation"^^xsd:string .

wt:WindTurbine a owl:Class ;
    rdfs:label "Wind Turbine"@en ;
    rdfs:comment "A horizontal-axis wind turbine as a whole."@en ;
    rdfs:subClassOf wt:Artifact .

wt:RobotTask a owl:Class ;
    rdfs:label "Robot Task"@en ;
    rdfs:comment "A task the robot executes as a CRAM plan."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:performedBy ;
            owl:someValuesFrom wt:Robot ],
        owl:Thing .

wt:modality_drone_rgb a wt:SensingModality,
        owl:NamedIndividual ;
    rdfs:label "RGB camera on a drone"@en .

wt:DrivetrainComponent a owl:Class ;
    rdfs:label "Drivetrain Component"@en ;
    rdfs:comment "Part of the power train from hub to generator."@en ;
    rdfs:subClassOf wt:TurbineComponent .

wt:drivetrain a wt:Drivetrain,
        owl:NamedIndividual ;
    rdfs:label "Drivetrain"@en ;
    wt:partOf wt:iea_3_4_130_rwt,
        wt:nacelle_assembly ;
    wt:urdfLink "drivetrain"^^xsd:string .

wt:MaintenanceAction a owl:Class ;
    rdfs:label "Maintenance Action"@en ;
    dcterms:source "ACP O&M Recommended Practices" ;
    rdfs:comment "What a technician does to remedy a fault."@en ;
    rdfs:subClassOf owl:Thing .

wt:TurbineComponent a owl:Class ;
    rdfs:label "Turbine Component"@en ;
    rdfs:comment "A part of a wind turbine that can be inspected, maintained or replaced."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:Assembly ],
        wt:Artifact .

wt:zone_tower a wt:Zone,
        owl:NamedIndividual ;
    rdfs:label "Tower"@en ;
    rdfs:comment "Inside the tower: ground floor, rest platforms, yaw deck."@en .

wt:nacelle_assembly a wt:Nacelle,
        owl:NamedIndividual ;
    rdfs:label "Nacelle"@en ;
    wt:partOf wt:iea_3_4_130_rwt .

wt:tower_section_1 a wt:TowerSection,
        owl:NamedIndividual ;
    rdfs:label "Tower section 1"@en ;
    wt:mountedOn wt:foundation ;
    wt:partOf wt:tower ;
    wt:urdfLink "tower_section_1"^^xsd:string .

wt:gearbox a wt:Gearbox,
        owl:NamedIndividual ;
    rdfs:label "Gearbox"@en ;
    wt:mountedOn wt:drivetrain ;
    wt:partOf wt:drivetrain ;
    wt:urdfLink "gearbox"^^xsd:string .

wt:severity_medium a wt:Severity,
        owl:NamedIndividual ;
    rdfs:label "medium"@en ;
    wt:severityRank 2 .

wt:tower a wt:Tower,
        owl:NamedIndividual ;
    rdfs:label "Tower"@en ;
    wt:partOf wt:iea_3_4_130_rwt .

wt:nacelle a wt:NacelleHousing,
        owl:NamedIndividual ;
    rdfs:label "Nacelle"@en ;
    wt:mountedOn wt:yaw_bearing ;
    wt:partOf wt:nacelle_assembly ;
    wt:urdfLink "nacelle"^^xsd:string .

wt:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "Part Of"@en ;
    rdfs:comment "Structural part-whole relation (transitive)."@en ;
    owl:inverseOf wt:hasPart .

wt:Fault a owl:Class ;
    rdfs:label "Fault"@en ;
    rdfs:comment "An abnormal condition of a turbine component that an inspection should find."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass wt:Severity ;
            owl:onProperty wt:hasSeverity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty wt:affects ;
            owl:someValuesFrom wt:TurbineComponent ],
        [ a owl:Restriction ;
            owl:onProperty wt:observableBy ;
            owl:someValuesFrom wt:SensingModality ],
        owl:Thing .

wt:severity_high a wt:Severity,
        owl:NamedIndividual ;
    rdfs:label "high"@en ;
    wt:severityRank 3 .

wt:zone_outside a wt:Zone,
        owl:NamedIndividual ;
    rdfs:label "Outside"@en ;
    rdfs:comment "Around the tower base and outside the nacelle (ground robot or drone)."@en .

wt:remediedBy a owl:ObjectProperty ;
    rdfs:label "Remedied By"@en ;
    rdfs:comment "What remedies the fault."@en ;
    rdfs:domain wt:Fault ;
    rdfs:range wt:MaintenanceAction .

wt:ConditionSignal a owl:Class ;
    rdfs:label "Condition Signal"@en ;
    rdfs:comment "A measured value from the turbine's condition monitoring (SCADA / CMS)."@en ;
    rdfs:subClassOf owl:Thing .

wt:zone_nacelle a wt:Zone,
        owl:NamedIndividual ;
    rdfs:label "Nacelle"@en ;
    rdfs:comment "Inside the nacelle: walkways along the drivetrain."@en .

wt:modality_rgb a wt:SensingModality,
        owl:NamedIndividual ;
    rdfs:label "RGB camera on the robot"@en .

wt:InspectionPoint a owl:Class ;
    rdfs:label "Inspection Point"@en ;
    rdfs:comment "A place on a component to look at, with the direction and distance a camera should look from."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass wt:TurbineComponent ;
            owl:onProperty wt:inspects ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass wt:Zone ;
            owl:onProperty wt:locatedInZone ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        owl:Thing .

[] a owl:AllDisjointClasses ;
    owl:members ( wt:MaterialDegradation wt:Leak wt:FastenerFault wt:ThermalFault wt:FunctionalFault wt:ExternalDamage wt:UnsafeCondition ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( wt:severity_low wt:severity_medium wt:severity_high ) .

[] a owl:AllDisjointClasses ;
    owl:members ( wt:TurbineComponent wt:Robot wt:Person wt:Tool wt:Site ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( wt:zone_outside wt:zone_tower wt:zone_nacelle ) .

