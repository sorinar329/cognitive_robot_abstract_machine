wt:AnchorBoltSet a owl:Class ;
    rdfs:label "Anchor Bolt Set"@en ;
    rdfs:comment "Anchor bolts and nuts of the tower base flange."@en ;
    rdfs:subClassOf wt:BoltSet .

wt:Anemometer a owl:Class ;
    rdfs:label "Anemometer"@en ;
    rdfs:comment "Cup anemometer."@en ;
    rdfs:subClassOf wt:AuxiliarySystem .

wt:AssistanceTask a owl:Class ;
    rdfs:label "Assistance Task"@en ;
    rdfs:comment "Help a technician, e.g. by bringing tools."@en ;
    rdfs:subClassOf wt:RobotTask .

wt:AviationLight a owl:Class ;
    rdfs:label "Aviation Light"@en ;
    rdfs:comment "Aviation obstruction light."@en ;
    rdfs:subClassOf wt:AuxiliarySystem .

wt:Bedplate a owl:Class ;
    rdfs:label "Bedplate"@en ;
    rdfs:comment "Nacelle main frame carrying the drivetrain."@en ;
    rdfs:subClassOf wt:StructuralComponent .

wt:BoltCheck a owl:Class ;
    rdfs:label "Bolt Check"@en ;
    rdfs:comment "Read torque markings of a bolted joint and assess its preload."@en ;
    rdfs:subClassOf wt:InspectionRound .

wt:BrakeCaliper a owl:Class ;
    rdfs:label "Brake Caliper"@en ;
    rdfs:comment "Hydraulic brake caliper."@en ;
    rdfs:subClassOf wt:DrivetrainComponent .

wt:BrakeDisc a owl:Class ;
    rdfs:label "Brake Disc"@en ;
    rdfs:comment "Disc of the mechanical rotor brake."@en ;
    rdfs:subClassOf wt:DrivetrainComponent .

wt:Breakout a owl:Class ;
    rdfs:label "Breakout"@en ;
    rdfs:comment "Material broken out, e.g. grout."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:StructuralRepair ],
        wt:MaterialDegradation .

wt:CableLoop a owl:Class ;
    rdfs:label "Cable Loop"@en ;
    rdfs:comment "Power cable loop under the yaw bearing, allowing the nacelle to yaw."@en ;
    rdfs:subClassOf wt:ElectricalComponent .

wt:Chafing a owl:Class ;
    rdfs:label "Chafing"@en ;
    rdfs:comment "Rubbing damage, e.g. cable insulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:ReplacePart ],
        wt:MaterialDegradation .

wt:Clean a owl:Class ;
    rdfs:label "Clean"@en ;
    rdfs:comment "Clean a surface or component."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:Clogging a owl:Class ;
    rdfs:label "Clogging"@en ;
    rdfs:comment "A filter is clogged."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:ReplaceFilter ],
        wt:FunctionalFault .

wt:CoatingDamage a owl:Class ;
    rdfs:label "Coating Damage"@en ;
    rdfs:comment "Damaged paint or coating."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:Recoat ],
        wt:MaterialDegradation .

wt:Contamination a owl:Class ;
    rdfs:label "Contamination"@en ;
    rdfs:comment "Dirt or dust where it harms, e.g. carbon dust at slip rings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:Clean ],
        wt:FunctionalFault .

wt:ControllerCabinet a owl:Class ;
    rdfs:label "Controller Cabinet"@en ;
    rdfs:comment "Turbine controller cabinet."@en ;
    rdfs:subClassOf wt:ElectricalComponent .

wt:ConverterCabinet a owl:Class ;
    rdfs:label "Converter Cabinet"@en ;
    rdfs:comment "Power converter cabinet."@en ;
    rdfs:subClassOf wt:ElectricalComponent .

wt:CoolantLevelGauge a owl:Class ;
    rdfs:label "Coolant Level Gauge"@en ;
    rdfs:comment "Level tube of the coolant expansion tank."@en ;
    rdfs:subClassOf wt:AuxiliarySystem .

wt:CoolingUnit a owl:Class ;
    rdfs:label "Cooling Unit"@en ;
    rdfs:comment "Liquid cooling of generator and converter."@en ;
    rdfs:subClassOf wt:AuxiliarySystem .

wt:CoverBoltSet a owl:Class ;
    rdfs:label "Cover Bolt Set"@en ;
    rdfs:comment "Bolts of the gearbox inspection cover."@en ;
    rdfs:subClassOf wt:BoltSet .

wt:CraneHatch a owl:Class ;
    rdfs:label "Crane Hatch"@en ;
    rdfs:comment "Rear floor hatch for the crane hoist."@en ;
    rdfs:subClassOf wt:Hatch .

wt:CraneHook a owl:Class ;
    rdfs:label "Crane Hook"@en ;
    rdfs:comment "Hook block of the service crane, reaching the ground."@en ;
    rdfs:subClassOf wt:HandlingEquipment .

wt:CraneRail a owl:Class ;
    rdfs:label "Crane Rail"@en ;
    rdfs:comment "Rail of the service crane."@en ;
    rdfs:subClassOf wt:HandlingEquipment .

wt:CraneTrolley a owl:Class ;
    rdfs:label "Crane Trolley"@en ;
    rdfs:comment "Trolley of the service crane."@en ;
    rdfs:subClassOf wt:HandlingEquipment .

wt:Disconnection a owl:Class ;
    rdfs:label "Disconnection"@en ;
    rdfs:comment "A connection is broken."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:Reconnect ],
        wt:FunctionalFault .

wt:EarthingStrap a owl:Class ;
    rdfs:label "Earthing Strap"@en ;
    rdfs:comment "Earthing connection from tower flange to foundation."@en ;
    rdfs:subClassOf wt:ElectricalComponent .

wt:EmptyCollector a owl:Class ;
    rdfs:label "Empty Collector"@en ;
    rdfs:comment "Empty a grease collector."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:Fastener a owl:Class ;
    rdfs:label "Fastener"@en ;
    rdfs:comment "Bolted connections."@en ;
    rdfs:subClassOf wt:TurbineComponent .

wt:FaultIndication a owl:Class ;
    rdfs:label "Fault Indication"@en ;
    rdfs:comment "A device reports a fault (red light, fault code)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue wt:ge_3mw_module_3d ;
            owl:onProperty wt:describedIn ],
        [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:Diagnose ],
        wt:FunctionalFault .

wt:FireExtinguisher a owl:Class ;
    rdfs:label "Fire Extinguisher"@en ;
    rdfs:comment "Portable fire extinguisher."@en ;
    rdfs:subClassOf wt:SafetyEquipment .

wt:FlexibleCoupling a owl:Class ;
    rdfs:label "Flexible Coupling"@en ;
    rdfs:comment "Disc-pack coupling between gearbox and generator."@en ;
    rdfs:subClassOf wt:DrivetrainComponent .

wt:FloorHatch a owl:Class ;
    rdfs:label "Floor Hatch"@en ;
    rdfs:comment "Hatch between tower and nacelle."@en ;
    rdfs:subClassOf wt:Hatch .

wt:FoundationPlinth a owl:Class ;
    rdfs:label "Foundation Plinth"@en ;
    rdfs:comment "Concrete pedestal of the foundation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:Foundation ],
        wt:StructuralComponent .

wt:Generator a owl:Class ;
    rdfs:label "Generator"@en ;
    rdfs:comment "Doubly-fed induction generator."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:Drivetrain ],
        wt:DrivetrainComponent .

wt:GreaseCollector a owl:Class ;
    rdfs:label "Grease Collector"@en ;
    rdfs:comment "Container collecting spent bearing grease."@en ;
    rdfs:subClassOf wt:DrivetrainComponent .

wt:GreaseLeak a owl:Class ;
    rdfs:label "Grease Leak"@en ;
    rdfs:comment "Bearing grease leaking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:Reseal ],
        wt:Leak .

wt:Ground a owl:Class ;
    rdfs:label "Ground"@en ;
    rdfs:comment "Terrain around the tower: grass, crane pad, road."@en ;
    rdfs:subClassOf wt:Site .

wt:GroundController a owl:Class ;
    rdfs:label "Ground Controller"@en ;
    rdfs:comment "Control cabinet on the tower ground floor."@en ;
    rdfs:subClassOf wt:ElectricalComponent .

wt:GroutJoint a owl:Class ;
    rdfs:label "Grout Joint"@en ;
    rdfs:comment "Grout layer under the tower base flange."@en ;
    rdfs:subClassOf wt:StructuralComponent .

wt:HighSpeedShaft a owl:Class ;
    rdfs:label "High Speed Shaft"@en ;
    rdfs:comment "Shaft from gearbox to generator."@en ;
    rdfs:subClassOf wt:DrivetrainComponent .

wt:Hub a owl:Class ;
    rdfs:label "Hub"@en ;
    rdfs:comment "Cast hub carrying the blades."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:Rotor ],
        wt:StructuralComponent .

wt:HumanoidRobot a owl:Class ;
    rdfs:label "Humanoid Robot"@en ;
    rdfs:comment "A robot with a human-like body."@en ;
    rdfs:subClassOf wt:Robot .

wt:HydraulicLeak a owl:Class ;
    rdfs:label "Hydraulic Leak"@en ;
    rdfs:comment "Hydraulic oil leaking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:ReplacePart ],
        wt:Leak .

wt:HydraulicUnit a owl:Class ;
    rdfs:label "Hydraulic Unit"@en ;
    rdfs:comment "Hydraulic power unit (brake, yaw brakes)."@en ;
    rdfs:subClassOf wt:AuxiliarySystem .

wt:LiftGuide a owl:Class ;
    rdfs:label "Lift Guide"@en ;
    rdfs:comment "Guide and hoist wires of the service lift."@en ;
    rdfs:subClassOf wt:HandlingEquipment .

wt:LiftingPlatform a owl:Class ;
    rdfs:label "Lifting Platform"@en ;
    rdfs:comment "Platform hung from the crane hook; hoists a robot or loads through the rear floor hatch."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue wt:zone_nacelle ;
            owl:onProperty wt:providesAccessTo ],
        wt:HandlingEquipment .

wt:LightFailure a owl:Class ;
    rdfs:label "Light Failure"@en ;
    rdfs:comment "A light does not work."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:ReplacePart ],
        wt:FunctionalFault .

wt:LockEngaged a owl:Class ;
    rdfs:label "Lock Engaged"@en ;
    rdfs:comment "A lock is engaged that must be released."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:RestoreConfiguration ],
        wt:UnsafeCondition .

wt:MainBearing a owl:Class ;
    rdfs:label "Main Bearing"@en ;
    rdfs:comment "Main shaft bearing with seals."@en ;
    rdfs:subClassOf wt:DrivetrainComponent .

wt:MainShaft a owl:Class ;
    rdfs:label "Main Shaft"@en ;
    rdfs:comment "Low-speed shaft from hub to gearbox."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:Drivetrain ],
        wt:DrivetrainComponent .

wt:MechanicalDamage a owl:Class ;
    rdfs:label "Mechanical Damage"@en ;
    rdfs:comment "A device is mechanically damaged."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:ReplacePart ],
        wt:FunctionalFault .

wt:MissingFastener a owl:Class ;
    rdfs:label "Missing Fastener"@en ;
    rdfs:comment "A bolt is missing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:ReplaceFastener ],
        wt:FastenerFault .

wt:MissingSafetyEquipment a owl:Class ;
    rdfs:label "Missing Safety Equipment"@en ;
    rdfs:comment "Required safety equipment is not there."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:RestoreConfiguration ],
        wt:UnsafeCondition .

wt:NacelleHousing a owl:Class ;
    rdfs:label "Nacelle Housing"@en ;
    rdfs:comment "Glass-fibre cover of the nacelle."@en ;
    rdfs:subClassOf wt:StructuralComponent .

wt:OilFilterIndicator a owl:Class ;
    rdfs:label "Oil Filter Indicator"@en ;
    rdfs:comment "Clogging indicator of the offline oil filter."@en ;
    rdfs:subClassOf wt:DrivetrainComponent .

wt:OilLeak a owl:Class ;
    rdfs:label "Oil Leak"@en ;
    rdfs:comment "Gear oil leaking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:Reseal ],
        wt:Leak .

wt:OpenEnclosure a owl:Class ;
    rdfs:label "Open Enclosure"@en ;
    rdfs:comment "A cabinet or cover is left open."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:RestoreConfiguration ],
        wt:UnsafeCondition .

wt:Reconnect a owl:Class ;
    rdfs:label "Reconnect"@en ;
    rdfs:comment "Restore an electrical connection."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:Refill a owl:Class ;
    rdfs:label "Refill"@en ;
    rdfs:comment "Top up oil or coolant."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:ReplaceFastener a owl:Class ;
    rdfs:label "Replace Fastener"@en ;
    rdfs:comment "Replace bolt, nut and washers."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:ReplaceFilter a owl:Class ;
    rdfs:label "Replace Filter"@en ;
    rdfs:comment "Replace a filter element."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:Retension a owl:Class ;
    rdfs:label "Retension"@en ;
    rdfs:comment "Re-tension all bolts of a joint (hydraulic tensioner or torque wrench), cross pattern, two passes."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:Retighten a owl:Class ;
    rdfs:label "Retighten"@en ;
    rdfs:comment "Bring single bolts back to the specified torque."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:RotorLock a owl:Class ;
    rdfs:label "Rotor Lock"@en ;
    rdfs:comment "Mechanical lock of the rotor for work."@en ;
    rdfs:subClassOf wt:DrivetrainComponent .

wt:RotorLockPin a owl:Class ;
    rdfs:label "Rotor Lock Pin"@en ;
    rdfs:comment "Pin of the rotor lock."@en ;
    rdfs:subClassOf wt:DrivetrainComponent .

wt:SafetyKit a owl:Class ;
    rdfs:label "Safety Kit"@en ;
    rdfs:comment "First-aid kit and emergency equipment."@en ;
    rdfs:subClassOf wt:SafetyEquipment .

wt:Sensor a owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "A device that measures something."@en ;
    rdfs:subClassOf wt:RobotPart .

wt:ServiceCrane a owl:Class ;
    rdfs:label "Service Crane"@en ;
    rdfs:comment "On-board crane under the nacelle roof."@en ;
    rdfs:subClassOf wt:HandlingEquipment .

wt:ServiceDue a owl:Class ;
    rdfs:label "Service Due"@en ;
    rdfs:comment "A consumable is full or used up."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:EmptyCollector ],
        wt:FunctionalFault .

wt:ServiceLift a owl:Class ;
    rdfs:label "Service Lift"@en ;
    rdfs:comment "Service lift in the tower, ground floor to yaw deck."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue wt:zone_tower ;
            owl:onProperty wt:providesAccessTo ],
        wt:HandlingEquipment .

wt:ShrinkDiscBoltSet a owl:Class ;
    rdfs:label "Shrink Disc Bolt Set"@en ;
    rdfs:comment "Bolts of the shrink disc between main shaft and gearbox."@en ;
    rdfs:subClassOf wt:BoltSet .

wt:SightGlass a owl:Class ;
    rdfs:label "Sight Glass"@en ;
    rdfs:comment "Oil level sight glass."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:Gearbox ],
        wt:DrivetrainComponent .

wt:StatusLight a owl:Class ;
    rdfs:label "Status Light"@en ;
    rdfs:comment "Indicator light on a cabinet door."@en ;
    rdfs:subClassOf wt:ElectricalComponent .

wt:Technician a owl:Class ;
    rdfs:label "Technician"@en ;
    rdfs:comment "Service technician."@en ;
    rdfs:subClassOf wt:Person .

wt:ToolRack a owl:Class ;
    rdfs:label "Tool Rack"@en ;
    rdfs:comment "Rack for tools."@en ;
    rdfs:subClassOf wt:Storage .

wt:ToolTray a owl:Class ;
    rdfs:label "Tool Tray"@en ;
    rdfs:comment "Tray to put tools on at the work place."@en ;
    rdfs:subClassOf wt:Storage .

wt:TorqueArmBushing a owl:Class ;
    rdfs:label "Torque Arm Bushing"@en ;
    rdfs:comment "Elastomer bushing supporting the gearbox torque arm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:Gearbox ],
        wt:DrivetrainComponent .

wt:TorqueToolCase a owl:Class ;
    rdfs:label "Torque Tool Case"@en ;
    rdfs:comment "Case with the torque tool for bolted joints; carried by its T-grip."@en ;
    rdfs:subClassOf wt:Tool .

wt:TowerDoor a owl:Class ;
    rdfs:label "Tower Door"@en ;
    rdfs:comment "Entrance door at ground level."@en ;
    rdfs:subClassOf wt:Door .

wt:Transformer a owl:Class ;
    rdfs:label "Transformer"@en ;
    rdfs:comment "Cast-resin transformer."@en ;
    rdfs:subClassOf wt:ElectricalComponent .

wt:UnitreeG1 a owl:Class ;
    rdfs:label "Unitree G1"@en ;
    rdfs:comment "Unitree G1 humanoid (29 DoF, Dex3 hands, RealSense D435 head camera)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass wt:RobotHand ;
            owl:onProperty wt:hasRobotPart ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty wt:hasRobotPart ;
            owl:someValuesFrom wt:DepthCamera ],
        wt:HumanoidRobot .

wt:Wear a owl:Class ;
    rdfs:label "Wear"@en ;
    rdfs:comment "Wear of a consumable part, e.g. brake pads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:ReplacePart ],
        wt:MaterialDegradation .

wt:WeatherMast a owl:Class ;
    rdfs:label "Weather Mast"@en ;
    rdfs:comment "Mast on the nacelle roof."@en ;
    rdfs:subClassOf wt:AuxiliarySystem .

wt:YawBearing a owl:Class ;
    rdfs:label "Yaw Bearing"@en ;
    rdfs:comment "Slewing ring between tower and nacelle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:YawSystem ],
        wt:StructuralComponent .

wt:YawDeck a owl:Class ;
    rdfs:label "Yaw Deck"@en ;
    rdfs:comment "Top platform under the yaw bearing."@en ;
    rdfs:subClassOf wt:Platform .

wt:acp_om_recommended_practices a wt:MaintenanceDocument,
        owl:NamedIndividual ;
    rdfs:label "AWEA/ACP Operations and Maintenance Recommended Practices"@en ;
    rdfs:comment "AWEA/ACP Operations and Maintenance Recommended Practices, 2nd ed. 2017."@en .

wt:acp_rp_401 a wt:MaintenanceDocument,
        owl:NamedIndividual ;
    rdfs:label "ACP RP 401"@en ;
    rdfs:comment "ACP RP 401: foundation inspections and base bolt tensioning."@en .

wt:action_PickUpAction a wt:CRAMAction,
        owl:NamedIndividual ;
    rdfs:label "PickUpAction"@en ;
    rdfs:comment "Grasp and lift an object."@en .

wt:action_PlaceAction a wt:CRAMAction,
        owl:NamedIndividual ;
    rdfs:label "PlaceAction"@en ;
    rdfs:comment "Put an object down."@en .

wt:anchor_bolts a wt:AnchorBoltSet,
        owl:NamedIndividual ;
    rdfs:label "Anchor bolts"@en ;
    wt:boltCount 96 ;
    wt:fastens wt:foundation,
        wt:tower_section_1 ;
    wt:partOf wt:foundation_system ;
    rdfs:comment "96 anchor bolts on the base flange."@en .

wt:anemometer a wt:Anemometer,
        owl:NamedIndividual ;
    rdfs:label "Anemometer"@en ;
    wt:mountedOn wt:weather_mast ;
    wt:partOf wt:weather_mast ;
    wt:urdfLink "anemometer"^^xsd:string .

wt:aviation_light a wt:AviationLight,
        owl:NamedIndividual ;
    rdfs:label "Aviation light"@en ;
    wt:mountedOn wt:weather_mast ;
    wt:partOf wt:weather_mast ;
    wt:urdfLink "aviation_light"^^xsd:string .

wt:blade_1_inspect_leading_edge a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Blade 1: leading edge"@en ;
    wt:inspects wt:blade_1 ;
    wt:locatedInZone wt:zone_outside ;
    wt:viewDistance 5.0 ;
    rdfs:comment "blade 1 leading edge, outer third: erosion"@en .

wt:blade_1_inspect_tip_receptor a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Blade 1: tip receptor"@en ;
    wt:inspects wt:blade_1 ;
    wt:locatedInZone wt:zone_outside ;
    wt:viewDistance 4.0 ;
    rdfs:comment "blade 1 tip and lightning receptor, suction side"@en .

wt:blade_1_inspect_trailing_edge a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Blade 1: trailing edge"@en ;
    wt:inspects wt:blade_1 ;
    wt:locatedInZone wt:zone_outside ;
    wt:viewDistance 5.0 ;
    rdfs:comment "blade 1 trailing edge near the maximum chord: cracks, split bond line"@en .

wt:blade_2_inspect_leading_edge a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Blade 2: leading edge"@en ;
    wt:inspects wt:blade_2 ;
    wt:locatedInZone wt:zone_outside ;
    wt:viewDistance 5.0 ;
    rdfs:comment "blade 2 leading edge, outer third: erosion"@en .

wt:blade_2_inspect_tip_receptor a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Blade 2: tip receptor"@en ;
    wt:inspects wt:blade_2 ;
    wt:locatedInZone wt:zone_outside ;
    wt:viewDistance 4.0 ;
    rdfs:comment "blade 2 tip and lightning receptor, suction side"@en .

wt:blade_2_inspect_trailing_edge a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Blade 2: trailing edge"@en ;
    wt:inspects wt:blade_2 ;
    wt:locatedInZone wt:zone_outside ;
    wt:viewDistance 5.0 ;
    rdfs:comment "blade 2 trailing edge near the maximum chord: cracks, split bond line"@en .

wt:blade_3_inspect_leading_edge a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Blade 3: leading edge"@en ;
    wt:inspects wt:blade_3 ;
    wt:locatedInZone wt:zone_outside ;
    wt:viewDistance 5.0 ;
    rdfs:comment "blade 3 leading edge, outer third: erosion"@en .

wt:blade_3_inspect_tip_receptor a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Blade 3: tip receptor"@en ;
    wt:inspects wt:blade_3 ;
    wt:locatedInZone wt:zone_outside ;
    wt:viewDistance 4.0 ;
    rdfs:comment "blade 3 tip and lightning receptor, suction side"@en .

wt:blade_3_inspect_trailing_edge a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Blade 3: trailing edge"@en ;
    wt:inspects wt:blade_3 ;
    wt:locatedInZone wt:zone_outside ;
    wt:viewDistance 5.0 ;
    rdfs:comment "blade 3 trailing edge near the maximum chord: cracks, split bond line"@en .

wt:cabinet_controller_door a wt:CabinetDoor,
        owl:NamedIndividual ;
    rdfs:label "Cabinet controller door"@en ;
    wt:mountedOn wt:cabinet_controller ;
    wt:partOf wt:cabinet_controller ;
    wt:urdfLink "cabinet_controller_door"^^xsd:string .

wt:cable_loop a wt:CableLoop,
        owl:NamedIndividual ;
    rdfs:label "Cable loop"@en ;
    wt:mountedOn wt:tower_section_4 ;
    wt:partOf wt:tower ;
    wt:urdfLink "cable_loop"^^xsd:string .

wt:converter_inspect_status a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Converter: status"@en ;
    wt:inspects wt:cabinet_converter ;
    wt:locatedInZone wt:zone_nacelle ;
    wt:viewDistance 1.1 ;
    rdfs:comment "converter cabinet status light (green = ok)"@en .

wt:converter_status_light a wt:StatusLight,
        owl:NamedIndividual ;
    rdfs:label "Converter status light"@en ;
    wt:mountedOn wt:cabinet_converter_door ;
    wt:partOf wt:cabinet_converter_door ;
    wt:urdfLink "converter_status_light"^^xsd:string .

wt:cooling_inspect_level a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Cooling: level"@en ;
    wt:inspects wt:cooling_unit ;
    wt:locatedInZone wt:zone_nacelle ;
    wt:viewDistance 0.57 ;
    rdfs:comment "coolant expansion tank level tube (above the red mark)"@en .

wt:cooling_level a wt:CoolantLevelGauge,
        owl:NamedIndividual ;
    rdfs:label "Cooling level"@en ;
    wt:mountedOn wt:cooling_unit ;
    wt:partOf wt:cooling_unit ;
    wt:urdfLink "cooling_level"^^xsd:string .

wt:coupling_inspect a wt:InspectionPoint,
        owl:NamedIndividual ;
    rdfs:label "Coupling inspect"@en ;
    wt:inspects wt:brake_caliper ;
    wt:locatedInZone wt:zone_nacelle ;
    wt:viewDistance 1.3 ;
    rdfs:comment "flexible coupling disc packs: cracks, loose bolts"@en .

wt:crane_hook a wt:CraneHook,
        owl:NamedIndividual ;
    rdfs:label "Crane hook"@en ;
    wt:mountedOn wt:crane_trolley ;
    wt:partOf wt:service_crane ;
    wt:speed 4.0 ;
    wt:travel 115.0 ;
    wt:urdfLink "crane_hook"^^xsd:string .

wt:crane_rail a wt:CraneRail,
        owl:NamedIndividual ;
    rdfs:label "Crane rail"@en ;
