@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix wt: <http://www.semanticweb.org/windturbine-twin/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticweb.org/windturbine-twin/ontology> a owl:Ontology ;
    dcterms:description "Knowledge representation of an onshore wind turbine (IEA-3.4-130-RWT) for robot inspection and maintenance: components and their structure, faults and how they are observed, maintenance actions, access, and the Unitree G1 tasks. The individuals are generated from the Wind Turbine Twin model."@en ;
    dcterms:source "IEA Wind TCP Task 37, IEA-3.4-130-RWT (NREL/TP-5000-73492, 2019)" ;
    dcterms:title "Wind Turbine Twin ontology"@en ;
    owl:versionInfo "1.0" .

wt:DrivetrainFault a owl:Class ;
    rdfs:label "Drivetrain Fault"@en ;
    rdfs:comment "A fault on any part of the drivetrain (partOf is transitive)."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wt:Fault [ a owl:Restriction ;
                        owl:onProperty wt:affects ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:hasValue wt:drivetrain ;
                                owl:onProperty wt:partOf ] ] ) ] .

wt:DroneInspectableFault a owl:Class ;
    rdfs:label "Drone Inspectable Fault"@en ;
    rdfs:comment "A fault a drone camera can see (blades, outside of the nacelle)."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wt:Fault [ a owl:Restriction ;
                        owl:hasValue wt:modality_drone_rgb ;
                        owl:onProperty wt:observableBy ] ) ] .

wt:G1InspectableFault a owl:Class ;
    rdfs:label "G1 Inspectable Fault"@en ;
    rdfs:comment "A fault at an inspection point that a G1 task visits."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wt:Fault [ a owl:Restriction ;
                        owl:onProperty wt:observedAt ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty wt:visitedBy ;
                                owl:someValuesFrom wt:RobotTask ] ] ) ] .

wt:HighSeverityFault a owl:Class ;
    rdfs:label "High Severity Fault"@en ;
    rdfs:comment "A fault of high severity."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wt:Fault [ a owl:Restriction ;
                        owl:hasValue wt:severity_high ;
                        owl:onProperty wt:hasSeverity ] ) ] .

wt:MonitoredFault a owl:Class ;
    rdfs:label "Monitored Fault"@en ;
    rdfs:comment "A fault that also shows in a condition monitoring signal."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wt:Fault [ a owl:Restriction ;
                        owl:onProperty wt:indicatedBySignal ;
                        owl:someValuesFrom wt:ConditionSignal ] ) ] .

wt:NacelleFault a owl:Class ;
    rdfs:label "Nacelle Fault"@en ;
    rdfs:comment "A fault observed inside the nacelle."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wt:Fault [ a owl:Restriction ;
                        owl:onProperty wt:observedAt ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:hasValue wt:zone_nacelle ;
                                owl:onProperty wt:locatedInZone ] ] ) ] .

wt:ThermallyDetectableFault a owl:Class ;
    rdfs:label "Thermally Detectable Fault"@en ;
    rdfs:comment "A fault a thermal camera can see."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wt:Fault [ a owl:Restriction ;
                        owl:hasValue wt:modality_thermal ;
                        owl:onProperty wt:observableBy ] ) ] .

wt:assists a owl:ObjectProperty ;
    rdfs:label "Assists"@en ;
    rdfs:comment "Who the task helps."@en ;
    rdfs:domain wt:RobotTask ;
    rdfs:range wt:Person .

wt:bedplate a wt:Bedplate,
        owl:NamedIndividual ;
    rdfs:label "Bedplate"@en ;
    wt:mountedOn wt:nacelle ;
    wt:partOf wt:nacelle_assembly ;
    wt:urdfLink "bedplate"^^xsd:string .

wt:boltCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Bolt Count"@en ;
    rdfs:comment "Number of bolts."@en ;
    rdfs:domain wt:BoltSet ;
    rdfs:range xsd:integer .

wt:boltSize a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Bolt Size"@en ;
    rdfs:comment "Thread size, e.g. M42 (property class 10.9)."@en ;
    rdfs:domain wt:BoltSet ;
    rdfs:range xsd:string .

wt:cameraHeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Camera Height"@en ;
    rdfs:comment "Camera height above the floor (m)."@en ;
    rdfs:domain wt:Robot ;
    rdfs:range xsd:decimal .

wt:carries a owl:ObjectProperty ;
    rdfs:label "Carries"@en ;
    rdfs:comment "What the robot carries."@en ;
    rdfs:domain wt:RobotTask ;
    rdfs:range wt:Tool .

wt:crameraScene a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Cramera Scene"@en ;
    rdfs:comment "Name of the CRAMERA recording."@en ;
    rdfs:domain wt:RobotTask ;
    rdfs:range xsd:string .

wt:crane_hatch a wt:CraneHatch,
        owl:NamedIndividual ;
    rdfs:label "Crane hatch"@en ;
    wt:mountedOn wt:nacelle ;
    wt:partOf wt:nacelle_assembly ;
    wt:urdfLink "crane_hatch"^^xsd:string .

wt:fast_shaft_brake_disc a wt:BrakeDisc,
        owl:NamedIndividual ;
    rdfs:label "Fast shaft brake disc"@en ;
    wt:mountedOn wt:fast_shaft ;
    wt:partOf wt:fast_shaft ;
    wt:urdfLink "fast_shaft_brake_disc"^^xsd:string .

wt:fast_shaft_coupling a wt:FlexibleCoupling,
        owl:NamedIndividual ;
    rdfs:label "Fast shaft coupling"@en ;
    wt:mountedOn wt:fast_shaft ;
    wt:partOf wt:fast_shaft ;
    wt:urdfLink "fast_shaft_coupling"^^xsd:string .

wt:faultId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Fault Id"@en ;
    rdfs:comment "Identifier of the fault in the model's scenarios."@en ;
    rdfs:domain wt:Fault ;
    rdfs:range xsd:string .

wt:fault_blade_1_leading_edge_erosion a wt:Erosion,
        owl:NamedIndividual ;
    rdfs:label "blade 1 leading edge: leading edge erosion"@en ;
    wt:affects wt:blade_1 ;
    wt:faultId "blade_1.leading_edge_erosion"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:indicatedBySignal wt:signal_power_curve_deficit_percent ;
    wt:observableBy wt:modality_drone_rgb ;
    wt:observedAt wt:blade_1_inspect_leading_edge ;
    rdfs:comment "Leading-edge erosion on the outer blade: gelcoat worn through to the laminate"@en .

wt:fault_blade_1_lightning_damage a wt:LightningDamage,
        owl:NamedIndividual ;
    rdfs:label "blade 1 tip: lightning damage"@en ;
    wt:affects wt:blade_1 ;
    wt:faultId "blade_1.lightning_damage"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:indicatedBySignal wt:signal_blade_1_lightning_counter ;
    wt:observableBy wt:modality_drone_rgb ;
    wt:observedAt wt:blade_1_inspect_tip_receptor ;
    rdfs:comment "Lightning strike next to the tip receptor: burnt and delaminated shell"@en .

wt:fault_blade_1_trailing_edge_crack a wt:Crack,
        owl:NamedIndividual ;
    rdfs:label "blade 1 trailing edge: trailing edge crack"@en ;
    wt:affects wt:blade_1 ;
    wt:faultId "blade_1.trailing_edge_crack"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:observableBy wt:modality_drone_rgb ;
    wt:observedAt wt:blade_1_inspect_trailing_edge ;
    rdfs:comment "Trailing-edge bond line split open near the maximum chord"@en .

wt:fault_blade_2_leading_edge_erosion a wt:Erosion,
        owl:NamedIndividual ;
    rdfs:label "blade 2 leading edge: leading edge erosion"@en ;
    wt:affects wt:blade_2 ;
    wt:faultId "blade_2.leading_edge_erosion"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:indicatedBySignal wt:signal_power_curve_deficit_percent ;
    wt:observableBy wt:modality_drone_rgb ;
    wt:observedAt wt:blade_2_inspect_leading_edge ;
    rdfs:comment "Leading-edge erosion on the outer blade: gelcoat worn through to the laminate"@en .

wt:fault_blade_2_lightning_damage a wt:LightningDamage,
        owl:NamedIndividual ;
    rdfs:label "blade 2 tip: lightning damage"@en ;
    wt:affects wt:blade_2 ;
    wt:faultId "blade_2.lightning_damage"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:indicatedBySignal wt:signal_blade_2_lightning_counter ;
    wt:observableBy wt:modality_drone_rgb ;
    wt:observedAt wt:blade_2_inspect_tip_receptor ;
    rdfs:comment "Lightning strike next to the tip receptor: burnt and delaminated shell"@en .

wt:fault_blade_2_trailing_edge_crack a wt:Crack,
        owl:NamedIndividual ;
    rdfs:label "blade 2 trailing edge: trailing edge crack"@en ;
    wt:affects wt:blade_2 ;
    wt:faultId "blade_2.trailing_edge_crack"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:observableBy wt:modality_drone_rgb ;
    wt:observedAt wt:blade_2_inspect_trailing_edge ;
    rdfs:comment "Trailing-edge bond line split open near the maximum chord"@en .

wt:fault_blade_3_leading_edge_erosion a wt:Erosion,
        owl:NamedIndividual ;
    rdfs:label "blade 3 leading edge: leading edge erosion"@en ;
    wt:affects wt:blade_3 ;
    wt:faultId "blade_3.leading_edge_erosion"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:indicatedBySignal wt:signal_power_curve_deficit_percent ;
    wt:observableBy wt:modality_drone_rgb ;
    wt:observedAt wt:blade_3_inspect_leading_edge ;
    rdfs:comment "Leading-edge erosion on the outer blade: gelcoat worn through to the laminate"@en .

wt:fault_blade_3_lightning_damage a wt:LightningDamage,
        owl:NamedIndividual ;
    rdfs:label "blade 3 tip: lightning damage"@en ;
    wt:affects wt:blade_3 ;
    wt:faultId "blade_3.lightning_damage"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:indicatedBySignal wt:signal_blade_3_lightning_counter ;
    wt:observableBy wt:modality_drone_rgb ;
    wt:observedAt wt:blade_3_inspect_tip_receptor ;
    rdfs:comment "Lightning strike next to the tip receptor: burnt and delaminated shell"@en .

wt:fault_blade_3_trailing_edge_crack a wt:Crack,
        owl:NamedIndividual ;
    rdfs:label "blade 3 trailing edge: trailing edge crack"@en ;
    wt:affects wt:blade_3 ;
    wt:faultId "blade_3.trailing_edge_crack"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:observableBy wt:modality_drone_rgb ;
    wt:observedAt wt:blade_3_inspect_trailing_edge ;
    rdfs:comment "Trailing-edge bond line split open near the maximum chord"@en .

wt:fault_brake_disc_overheated a wt:Overheating,
        owl:NamedIndividual ;
    rdfs:label "brake disc: disc overheated"@en ;
    wt:affects wt:brake_caliper ;
    wt:faultId "brake.disc_overheated"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:indicatedBySignal wt:signal_brake_disc_temperature_c ;
    wt:observableBy wt:modality_rgb,
        wt:modality_thermal ;
    wt:observedAt wt:brake_inspect_caliper ;
    rdfs:comment "Brake disc overheated: blue temper colours on the friction faces"@en .

wt:fault_brake_pads_worn a wt:Wear,
        owl:NamedIndividual ;
    rdfs:label "brake pads: pads worn"@en ;
    wt:affects wt:brake_caliper ;
    wt:faultId "brake.pads_worn"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:indicatedBySignal wt:signal_brake_pad_wear_percent ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:brake_inspect_caliper ;
    rdfs:comment "Brake pads worn to the backing plate, wear pin out, brake dust below"@en .

wt:fault_controller_door_left_open a wt:OpenEnclosure,
        owl:NamedIndividual ;
    rdfs:label "controller cabinet: door left open"@en ;
    wt:affects wt:cabinet_controller_door ;
    wt:faultId "controller.door_left_open"^^xsd:string ;
    wt:hasSeverity wt:severity_low ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:controller_inspect_door ;
    rdfs:comment "Controller cabinet door left open after maintenance"@en .

wt:fault_converter_fault_light a wt:FaultIndication,
        owl:NamedIndividual ;
    rdfs:label "converter cabinet: fault light"@en ;
    wt:affects wt:converter_status_light ;
    wt:faultId "converter.fault_light"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:indicatedBySignal wt:signal_converter_fault_code ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:converter_inspect_status ;
    rdfs:comment "Converter reports a fault: red status light on the cabinet door"@en .

wt:fault_cooling_coolant_low a wt:FluidLevelLow,
        owl:NamedIndividual ;
    rdfs:label "cooling unit: coolant low"@en ;
    wt:affects wt:cooling_level ;
    wt:faultId "cooling.coolant_low"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:indicatedBySignal wt:signal_generator_winding_temperature_c ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:cooling_inspect_level ;
    rdfs:comment "Coolant below the minimum mark in the expansion tank"@en .

wt:fault_coupling_disc_pack_cracked a wt:Crack,
        owl:NamedIndividual ;
    rdfs:label "flexible coupling: disc pack cracked"@en ;
    wt:affects wt:brake_caliper ;
    wt:faultId "coupling.disc_pack_cracked"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:indicatedBySignal wt:signal_generator_vibration_mm_s ;
    wt:observableBy wt:modality_rgb,
        wt:modality_vibration ;
    wt:observedAt wt:coupling_inspect ;
    rdfs:comment "Crack through the gearbox-side coupling disc pack, a segment displaced"@en .

wt:fault_foundation_earthing_disconnected a wt:Disconnection,
        owl:NamedIndividual ;
    rdfs:label "earthing strap: earthing disconnected"@en ;
    wt:affects wt:foundation ;
    wt:faultId "foundation.earthing_disconnected"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:indicatedBySignal wt:signal_earthing_resistance_ohm ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:foundation_inspect_earthing ;
    rdfs:comment "Earthing strap torn off the tower flange, lying on the plinth"@en .

wt:fault_foundation_grout_breakout a wt:Breakout,
        owl:NamedIndividual ;
    rdfs:label "grout joint: grout breakout"@en ;
    wt:affects wt:foundation ;
    wt:faultId "foundation.grout_breakout"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:foundation_inspect_grout ;
    rdfs:comment "Grout broken out under the base flange, debris on the plinth"@en .

wt:fault_foundation_plinth_crack a wt:Crack,
        owl:NamedIndividual ;
    rdfs:label "foundation plinth: plinth crack"@en ;
    wt:affects wt:foundation ;
    wt:faultId "foundation.plinth_crack"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:foundation_inspect_plinth ;
    rdfs:comment "Crack running down the plinth and across its top towards the grout"@en .

wt:fault_gearbox_cover_bolt_missing a wt:MissingFastener,
        owl:NamedIndividual ;
    rdfs:label "inspection cover: cover bolt missing"@en ;
    wt:affects wt:gearbox_cover_bolts ;
    wt:faultId "gearbox.cover_bolt_missing"^^xsd:string ;
    wt:hasSeverity wt:severity_low ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:gearbox_inspect_cover ;
    rdfs:comment "One inspection cover bolt missing (loosened by vibration)"@en .

wt:fault_gearbox_filter_clogged a wt:Clogging,
        owl:NamedIndividual ;
    rdfs:label "offline oil filter: filter clogged"@en ;
    wt:affects wt:gearbox ;
    wt:faultId "gearbox.filter_clogged"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:indicatedBySignal wt:signal_gearbox_filter_dp_bar,
        wt:signal_gearbox_oil_particle_count ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:gearbox_inspect_filter ;
    rdfs:comment "Oil filter clogged, differential pressure indicator popped out"@en .

wt:fault_gearbox_oil_leak_input_seal a wt:OilLeak,
        owl:NamedIndividual ;
    rdfs:label "input shaft seal: oil leak input seal"@en ;
    wt:affects wt:gearbox ;
    wt:faultId "gearbox.oil_leak_input_seal"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:indicatedBySignal wt:signal_gearbox_oil_level ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:gearbox_inspect_input_seal ;
    rdfs:comment "Worn input shaft seal: oil runs down the front cover and pools on the floor"@en .

wt:fault_gearbox_oil_level_low a wt:FluidLevelLow,
        owl:NamedIndividual ;
    rdfs:label "oil sump: oil level low"@en ;
    wt:affects wt:gearbox_sight_glass ;
    wt:faultId "gearbox.oil_level_low"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:indicatedBySignal wt:signal_gearbox_oil_level,
        wt:signal_gearbox_oil_temperature_c ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:gearbox_inspect_sight_glass ;
    rdfs:comment "Oil level below minimum in the sight glass"@en .

wt:fault_gearbox_torque_arm_bushing_cracked a wt:Crack,
        owl:NamedIndividual ;
    rdfs:label "torque arm bushing (-Y): torque arm bushing cracked"@en ;
    wt:affects wt:gearbox ;
    wt:faultId "gearbox.torque_arm_bushing_cracked"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:indicatedBySignal wt:signal_gearbox_vibration_mm_s ;
    wt:observableBy wt:modality_rgb,
        wt:modality_vibration ;
    wt:observedAt wt:gearbox_inspect_bushing_left ;
    rdfs:comment "Elastomer bushing aged: torn and bulging out of the arm eye, gearbox vibrates more"@en .

wt:fault_generator_slip_ring_carbon_dust a wt:Contamination,
        owl:NamedIndividual ;
    rdfs:label "slip ring / brushes: slip ring carbon dust"@en ;
    wt:affects wt:generator ;
    wt:faultId "generator.slip_ring_carbon_dust"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:indicatedBySignal wt:signal_generator_brush_wear_percent ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:generator_inspect_slip_ring ;
    rdfs:comment "Worn slip-ring brushes: carbon dust below the housing and on the cover"@en .

wt:fault_generator_terminal_box_overheating a wt:Overheating,
        owl:NamedIndividual ;
    rdfs:label "terminal box: terminal box overheating"@en ;
    wt:affects wt:generator ;
    wt:faultId "generator.terminal_box_overheating"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:indicatedBySignal wt:signal_generator_terminal_temperature_c ;
    wt:observableBy wt:modality_rgb,
        wt:modality_thermal ;
    wt:observedAt wt:generator_inspect_terminal_box ;
    rdfs:comment "Loose power connection overheating the terminal box, paint scorched"@en .

wt:fault_hydraulic_hose_leak a wt:HydraulicLeak,
        owl:NamedIndividual ;
    rdfs:label "hydraulic unit: hose leak"@en ;
    wt:affects wt:hydraulic_unit ;
    wt:faultId "hydraulic.hose_leak"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:indicatedBySignal wt:signal_hydraulic_pressure_bar ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:hydraulic_inspect ;
    rdfs:comment "Brake hose fitting leaking: oil down the tank and onto the walkway"@en .

wt:fault_main_bearing_grease_collector_full a wt:ServiceDue,
        owl:NamedIndividual ;
    rdfs:label "grease collector: grease collector full"@en ;
    wt:affects wt:main_bearing_grease_collector ;
    wt:faultId "main_bearing.grease_collector_full"^^xsd:string ;
    wt:hasSeverity wt:severity_low ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:main_bearing_inspect_grease_collector ;
    rdfs:comment "Used-grease collector full, must be emptied"@en .

wt:fault_main_bearing_grease_leak_front_seal a wt:GreaseLeak,
        owl:NamedIndividual ;
    rdfs:label "main bearing upwind seal: grease leak front seal"@en ;
    wt:affects wt:main_bearing ;
    wt:faultId "main_bearing.grease_leak_front_seal"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:indicatedBySignal wt:signal_main_bearing_temperature_c ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:main_bearing_inspect_front_seal ;
    rdfs:comment "Front main bearing downwind seal worn: grease pushed out and running onto the bearing foot"@en .

wt:fault_main_shaft_fretting_corrosion a wt:Corrosion,
        owl:NamedIndividual ;
    rdfs:label "shaft / shrink disc interface: fretting corrosion"@en ;
    wt:affects wt:main_shaft ;
    wt:faultId "main_shaft.fretting_corrosion"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:indicatedBySignal wt:signal_drivetrain_vibration_mm_s ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:main_shaft_inspect_shrink_disc ;
    rdfs:comment "Fretting corrosion: red-brown powder where the shaft enters the shrink disc"@en .

wt:fault_main_shaft_shrink_disc_bolt_loose a wt:LooseFastener,
        owl:NamedIndividual ;
    rdfs:label "shrink disc: shrink disc bolt loose"@en ;
    wt:affects wt:main_shaft_shrink_disc_bolts ;
    wt:faultId "main_shaft.shrink_disc_bolt_loose"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:main_shaft_inspect_shrink_disc ;
    rdfs:comment "One shrink disc bolt backed out, torque marker no longer aligned"@en .

wt:fault_nacelle_anemometer_damaged a wt:MechanicalDamage,
        owl:NamedIndividual ;
    rdfs:label "anemometer: anemometer damaged"@en ;
    wt:affects wt:anemometer ;
    wt:faultId "nacelle.anemometer_damaged"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:indicatedBySignal wt:signal_anemometer_plausible ;
    wt:observableBy wt:modality_drone_rgb ;
    wt:observedAt wt:nacelle_inspect_weather_mast ;
    rdfs:comment "Cup anemometer damaged: one cup torn off, one arm bent"@en .

wt:fault_nacelle_aviation_light_failed a wt:LightFailure,
        owl:NamedIndividual ;
    rdfs:label "aviation obstruction light: aviation light failed"@en ;
    wt:affects wt:aviation_light ;
    wt:faultId "nacelle.aviation_light_failed"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:indicatedBySignal wt:signal_aviation_light_on ;
    wt:observableBy wt:modality_drone_rgb ;
    wt:observedAt wt:nacelle_inspect_weather_mast ;
    rdfs:comment "Aviation light dark with a broken dome"@en .

wt:fault_nacelle_cover_crack a wt:Crack,
        owl:NamedIndividual ;
    rdfs:label "nacelle cover: cover crack"@en ;
    wt:affects wt:nacelle ;
    wt:faultId "nacelle.cover_crack"^^xsd:string ;
    wt:hasSeverity wt:severity_low ;
    wt:observableBy wt:modality_drone_rgb ;
    wt:observedAt wt:nacelle_inspect_cover ;
    rdfs:comment "Crack in the GRP cover on the -Y side, rain can get in"@en .

wt:fault_rotor_lock_left_engaged a wt:LockEngaged,
        owl:NamedIndividual ;
    rdfs:label "rotor lock: left engaged"@en ;
    wt:affects wt:rotor_lock ;
    wt:faultId "rotor_lock.left_engaged"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:rotor_lock_inspect ;
    rdfs:comment "Rotor lock pin left engaged after maintenance"@en .

wt:fault_safety_extinguisher_missing a wt:MissingSafetyEquipment,
        owl:NamedIndividual ;
    rdfs:label "fire extinguisher: extinguisher missing"@en ;
    wt:affects wt:nacelle ;
    wt:faultId "safety.extinguisher_missing"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:safety_inspect_extinguisher ;
    rdfs:comment "Fire extinguisher missing from its bracket"@en .

wt:fault_tower_anchor_nut_corrosion a wt:Corrosion,
        owl:NamedIndividual ;
    rdfs:label "anchor bolts: anchor nut corrosion"@en ;
    wt:affects wt:anchor_bolts ;
    wt:faultId "tower.anchor_nut_corrosion"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:tower_inspect_anchor_nuts ;
    rdfs:comment "Corroded anchor nuts in one sector, rust running onto the plinth"@en .

wt:fault_tower_base_coating_damage a wt:CoatingDamage,
        owl:NamedIndividual ;
    rdfs:label "tower coating: base coating damage"@en ;
    wt:affects wt:tower_section_1 ;
    wt:faultId "tower.base_coating_damage"^^xsd:string ;
    wt:hasSeverity wt:severity_low ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:tower_inspect_base_coating ;
    rdfs:comment "Paint damage with rust patches and a rust streak near the tower base"@en .

wt:fault_tower_cable_loop_chafed a wt:Chafing,
        owl:NamedIndividual ;
    rdfs:label "cable loop: cable loop chafed"@en ;
    wt:affects wt:cable_loop ;
    wt:faultId "tower.cable_loop_chafed"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:tower_inspect_cable_loop ;
    rdfs:comment "Cable loop rubbed through at the saddle edge, copper showing, insulation flakes on the deck"@en .

wt:fault_tower_flange_2_bolts_loose a wt:LooseFastener,
        owl:NamedIndividual ;
    rdfs:label "flange 2 bolts: flange 2 bolts loose"@en ;
    wt:affects wt:flange_2_bolts ;
    wt:faultId "tower.flange_2_bolts_loose"^^xsd:string ;
    wt:hasSeverity wt:severity_high ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:tower_inspect_flange_2 ;
    rdfs:comment "Torque markings turned on flange 2: nut 20 by 25 deg, nut 21 by 40 deg, nut 22 by 180 deg, nut 60 by 15 deg (turning back 105 deg releases all preload)"@en .

wt:fault_tower_flange_3_bolts_loose a wt:LooseFastener,
        owl:NamedIndividual ;
    rdfs:label "flange 3 bolts: flange 3 bolts loose"@en ;
    wt:affects wt:flange_3_bolts ;
    wt:faultId "tower.flange_3_bolts_loose"^^xsd:string ;
    wt:hasSeverity wt:severity_medium ;
    wt:observableBy wt:modality_rgb ;
    wt:observedAt wt:tower_inspect_flange_3 ;
    rdfs:comment "Torque markings turned on flange 3: nut 75 by 14 deg (turning back 117 deg releases all preload)"@en .

