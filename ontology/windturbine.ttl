wt:vestas_v90_safety a wt:MaintenanceDocument,
        owl:NamedIndividual ;
    rdfs:label "Vestas V90-3 MW safety regulations for operators and technicians."@en ;
    rdfs:comment "Vestas V90-3 MW safety regulations for operators and technicians."@en .

wt:viewDistance a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "View Distance"@en ;
    rdfs:comment "Camera distance to look from (m)."@en ;
    rdfs:domain wt:InspectionPoint ;
    rdfs:range xsd:decimal .

wt:visits a owl:ObjectProperty ;
    rdfs:label "Visits"@en ;
    rdfs:comment "Inspection points a task looks at."@en ;
