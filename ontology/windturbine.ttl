wt:AccessTask a owl:Class ;
    rdfs:label "Access Task"@en ;
    rdfs:comment "Get the robot to a zone it cannot walk to (lift, hoist)."@en ;
    rdfs:subClassOf wt:RobotTask .

wt:CabinetDoor a owl:Class ;
    rdfs:label "Cabinet Door"@en ;
    rdfs:comment "Door of a switch cabinet."@en ;
    rdfs:subClassOf wt:Door .

wt:Corrosion a owl:Class ;
    rdfs:label "Corrosion"@en ;
    rdfs:comment "Rust or fretting corrosion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:Recoat ],
        wt:MaterialDegradation .

wt:DepthCamera a owl:Class ;
    rdfs:label "Depth Camera"@en ;
    rdfs:comment "RGB-D camera."@en ;
    rdfs:subClassOf wt:Sensor .

wt:Diagnose a owl:Class ;
    rdfs:label "Diagnose"@en ;
    rdfs:comment "Read the fault code and diagnose the device."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:Door a owl:Class ;
    rdfs:label "Door"@en ;
    rdfs:comment "A door."@en ;
    rdfs:subClassOf wt:AccessStructure .

wt:ExternalDamage a owl:Class ;
    rdfs:label "External Damage"@en ;
    rdfs:comment "Damage from outside."@en ;
    rdfs:subClassOf wt:Fault .

wt:FluidLevelLow a owl:Class ;
    rdfs:label "Fluid Level Low"@en ;
    rdfs:comment "Oil or coolant below the minimum mark."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:Refill ],
        wt:FunctionalFault .

wt:Foundation a owl:Class ;
    rdfs:label "Foundation"@en ;
    rdfs:comment "Concrete foundation with plinth, grout joint and anchor bolts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:WindTurbine ],
        wt:Assembly .

wt:Hatch a owl:Class ;
    rdfs:label "Hatch"@en ;
    rdfs:comment "A floor hatch."@en ;
    rdfs:subClassOf wt:AccessStructure .

wt:Nacelle a owl:Class ;
    rdfs:label "Nacelle"@en ;
    rdfs:comment "Machine housing on the tower top, turning about the yaw axis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:WindTurbine ],
        wt:Assembly .

wt:Overheating a owl:Class ;
    rdfs:label "Overheating"@en ;
    rdfs:comment "Temperature above its limit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:remediedBy ;
            owl:someValuesFrom wt:Diagnose ],
        wt:ThermalFault .

wt:Platform a owl:Class ;
    rdfs:label "Platform"@en ;
    rdfs:comment "Floor inside the tower."@en ;
    rdfs:subClassOf wt:AccessStructure .

wt:Recoat a owl:Class ;
    rdfs:label "Recoat"@en ;
    rdfs:comment "Remove corrosion and repaint."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:Reseal a owl:Class ;
    rdfs:label "Reseal"@en ;
    rdfs:comment "Replace a seal."@en ;
    rdfs:subClassOf wt:MaintenanceAction .

wt:SafetyEquipment a owl:Class ;
    rdfs:label "Safety Equipment"@en ;
    rdfs:comment "Equipment for the safety of people."@en ;
    rdfs:subClassOf wt:TurbineComponent .

wt:Site a owl:Class ;
    rdfs:label "Site"@en ;
    rdfs:comment "The turbine's surroundings."@en ;
    rdfs:subClassOf wt:PhysicalObject .

wt:Storage a owl:Class ;
    rdfs:label "Storage"@en ;
    rdfs:comment "Where tools are kept."@en ;
    rdfs:subClassOf wt:TurbineComponent .

wt:ThermalFault a owl:Class ;
    rdfs:label "Thermal Fault"@en ;
    rdfs:comment "Too hot."@en ;
    rdfs:subClassOf wt:Fault .

wt:Tower a owl:Class ;
    rdfs:label "Tower"@en ;
    rdfs:comment "Tubular steel tower, bolted from sections, with its interior."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:WindTurbine ],
        wt:Assembly .

wt:YawSystem a owl:Class ;
    rdfs:label "Yaw System"@en ;
    rdfs:comment "Yaw bearing and drives turning the nacelle into the wind."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty wt:partOf ;
            owl:someValuesFrom wt:WindTurbine ],
        wt:Assembly .

