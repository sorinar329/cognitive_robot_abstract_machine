wt:task_t0 a wt:InspectionRound,
        owl:NamedIndividual ;
    rdfs:label "T0: look at the tower door"@en ;
    wt:crameraScene "windturbine_g1_t1"^^xsd:string ;
    wt:performedBy wt:g1 ;
    wt:scriptPath "scripts/g1_inspection_round.py"^^xsd:string ;
    wt:takesPlaceIn wt:zone_outside ;
    wt:usesAction wt:action_LookAtAction,
        wt:action_NavigateAction ;
    wt:visits wt:tower_inspect_door .

wt:task_t1 a wt:InspectionRound,
        owl:NamedIndividual ;
    rdfs:label "T1: tower base round"@en ;
    wt:crameraScene "windturbine_g1_t1"^^xsd:string ;
    wt:performedBy wt:g1 ;
    wt:scriptPath "scripts/g1_inspection_round.py"^^xsd:string ;
    wt:takesPlaceIn wt:zone_outside ;
    wt:usesAction wt:action_LookAtAction,
        wt:action_NavigateAction,
        wt:action_ParkArmsAction ;
    wt:visits wt:foundation_inspect_earthing,
        wt:foundation_inspect_grout,
        wt:foundation_inspect_plinth,
        wt:tower_inspect_anchor_nuts,
        wt:tower_inspect_base_coating,
        wt:tower_inspect_door .

wt:task_t2 a wt:InspectionRound,
        owl:NamedIndividual ;
    rdfs:label "T2: nacelle walkway round"@en ;
    wt:crameraScene "windturbine_g1_t2"^^xsd:string ;
    wt:performedBy wt:g1 ;
    wt:scriptPath "scripts/g1_inspection_round.py"^^xsd:string ;
    wt:takesPlaceIn wt:zone_nacelle ;
    wt:usesAction wt:action_LookAtAction,
        wt:action_ParkArmsAction,
        wt:action_StraightMove ;
    wt:visits wt:gearbox_inspect_bushing_left,
        wt:gearbox_inspect_input_seal,
        wt:gearbox_inspect_sight_glass,
        wt:generator_inspect_slip_ring,
        wt:main_bearing_inspect_grease_collector,
        wt:main_shaft_inspect_shrink_disc .

wt:task_t3 a wt:AssistanceTask,
        owl:NamedIndividual ;
    rdfs:label "T3: find the loose bolt, bring the torque tool"@en ;
    wt:assists wt:technician ;
    wt:carries wt:torque_tool_case ;
    wt:crameraScene "windturbine_g1_t3"^^xsd:string ;
    wt:performedBy wt:g1 ;
    wt:scriptPath "scripts/g1_bring_the_tool.py"^^xsd:string ;
    wt:takesPlaceIn wt:zone_nacelle ;
    wt:usesAction wt:action_LookAtAction,
        wt:action_ParkArmsAction,
        wt:action_PickUpAction,
        wt:action_PlaceAction,
        wt:action_StraightMove ;
    wt:visits wt:main_shaft_inspect_shrink_disc .

wt:task_t4 a wt:AccessTask,
        owl:NamedIndividual ;
    rdfs:label "T4: crane hoist into the nacelle"@en ;
    wt:crameraScene "windturbine_g1_t4"^^xsd:string ;
    wt:performedBy wt:g1 ;
    wt:rides wt:lifting_platform ;
    wt:scriptPath "scripts/g1_climb.py"^^xsd:string ;
    wt:takesPlaceIn wt:zone_nacelle,
        wt:zone_outside ;
    wt:usesAction wt:action_LookAtAction,
        wt:action_RideCarrier,
        wt:action_StraightMove ;
    wt:visits wt:controller_inspect_door .

wt:task_t5 a wt:AccessTask,
        owl:NamedIndividual ;
    rdfs:label "T5: tower lift to the yaw deck"@en ;
    wt:crameraScene "windturbine_g1_t5"^^xsd:string ;
    wt:performedBy wt:g1 ;
    wt:rides wt:service_lift ;
    wt:scriptPath "scripts/g1_climb.py"^^xsd:string ;
    wt:takesPlaceIn wt:zone_outside,
        wt:zone_tower ;
    wt:usesAction wt:action_LookAtAction,
        wt:action_RideCarrier,
        wt:action_StraightMove ;
    wt:visits wt:tower_inspect_cable_loop .

wt:task_t6 a wt:BoltCheck,
        owl:NamedIndividual ;
    rdfs:label "T6: flange bolt check"@en ;
    wt:crameraScene "windturbine_g1_t6"^^xsd:string ;
    wt:performedBy wt:g1 ;
    wt:rides wt:service_lift ;
    wt:scriptPath "scripts/g1_tower_bolts.py"^^xsd:string ;
    wt:takesPlaceIn wt:zone_outside,
        wt:zone_tower ;
    wt:usesAction wt:action_LookAtAction,
        wt:action_RideCarrier,
        wt:action_StraightMove ;
    wt:visits wt:tower_inspect_flange_1,
        wt:tower_inspect_flange_2,
        wt:tower_inspect_flange_3 .

