  <rdf:Description rdf:about="http://www.semanticweb.org/windturbine-twin/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionInfo>1.0</owl:versionInfo>
    <dcterms:title xml:lang="en">Wind Turbine Twin ontology</dcterms:title>
    <dcterms:description xml:lang="en">Knowledge representation of an onshore wind turbine (IEA-3.4-130-RWT) for robot inspection and maintenance: components and their structure, faults and how they are observed, maintenance actions, access, and the Unitree G1 tasks. The individuals are generated from the Wind Turbine Twin model.</dcterms:description>
    <dcterms:source>IEA Wind TCP Task 37, IEA-3.4-130-RWT (NREL/TP-5000-73492, 2019)</dcterms:source>
  </rdf:Description>
